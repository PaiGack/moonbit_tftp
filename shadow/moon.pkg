import {
  "PaiGack/moon_shadow/mooninfo",
  "PaiGack/moon_shadow/gitinfo",
  "PaiGack/moon_shadow/buildinfo",
}

virtual(implement: "PaiGack/moon_shadow/shadow")

// No `dev_build` rule here on purpose. `generated.mbt` is tracked, not
// produced: `moon publish` re-checks the packaged zip in a scratch directory
// with no `.git`, and the generator walks up from the module looking for one —
// in that environment it does not answer, it spins, and the check never
// returns. A rule that only works in a checkout is a rule that breaks the one
// build that has no checkout at all. `scripts/shadow.sh` refreshes the file by
// hand; `moon test` fails when it drifts from `moon.mod`.
